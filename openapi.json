  "/api/v1/tools.json": {
   "get": {
    "operationId": "listTools",
    "summary": "List AI GTM tools",
    "description": "All tools ranked by value score, with entry price, currency, price status, pricing source URL and last-verified date. Optional filters.",
    "tags": [
     "data"
    ],
    "parameters": [
     {
      "name": "use_case",
      "in": "query",
      "required": false,
      "description": "Filter by use case id",
      "schema": {
       "type": "string",
       "enum": [
        "positioning",
        "list-building",
        "enrichment",
        "outbound-email",
        "linkedin",
        "ai-sdr",
        "signals",
        "search-performance",
        "content-optimization",
        "aeo",
        "social-scheduling",
        "landing-pages",
        "newsletters",
        "design-video",
        "community",
        "web-analytics",
        "crm"
       ]
      }
     },
     {
      "name": "team_size",
      "in": "query",
      "required": false,
      "description": "Filter to tools that fit a GTM team size",
      "schema": {
       "type": "string",
       "enum": [
        "solo",
        "small",
        "early",
        "scaling",
        "large"
       ]
      }
     },
     {
      "name": "max_price",
      "in": "query",
      "required": false,
      "description": "Maximum entry price per month (USD); excludes contact-sales tools",
      "schema": {
       "type": "number",
       "minimum": 0
      }
     },
     {
      "name": "q",
      "in": "query",
      "required": false,
      "description": "Case-insensitive text match on tool name or use case",
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "meta",
          "data"
         ],
         "properties": {
          "meta": {
           "$ref": "#/components/schemas/Meta"
          },
          "data": {
           "type": "array",
           "items": {
            "$ref": "#/components/schemas/Tool"
           }
          }
         }
        }
       }
      }
     },
     "404": {
      "description": "Not found (RFC 9457 problem details)",
      "content": {
       "application/problem+json": {
        "schema": {
         "$ref": "#/components/schemas/Problem"
        }
       }
      }
     }
    }
   }
  },
